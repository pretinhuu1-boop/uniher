# UniHER runtime environment template
# Copy to .env.local for local work or .env.production on the target host.
# Never commit real secrets.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_PATH=./data/uniher.db

# Required. Use different random values with at least 32 characters each.
JWT_SECRET=replace-with-32-plus-character-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-character-refresh-secret

# Required for employee CSV import privacy hashing. Keep stable per environment.
UNIHER_EMPLOYEE_IMPORT_HMAC_SECRET=replace-with-32-plus-character-import-hmac-secret

# Production HTTPS must keep this false or unset.
ALLOW_INSECURE_HTTP_COOKIES=false

# Local/homologation can use memory. Production must use sqlite.
ACCESS_TOKEN_BLACKLIST_BACKEND=memory

# Required by production release preflight.
# Format: email:role,email:role
UNIHER_RELEASE_SMOKE_ACCOUNTS=admin@example.com:admin,rh@example.com:rh,colaboradora@example.com:colaboradora

# Optional mail/provider configuration.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
